# Copy this file to .env and fill in real values. Never commit .env.
# Consumed exclusively by the app's n8n client module — see docs/architecture/07-api-contract.md.

# Base URL of the n8n instance to call. Switch this (and nothing else) to move
# from local Docker n8n to a VPS-hosted n8n instance. See docs/architecture/04-future-vps-switch.md.
N8N_BASE_URL=http://127.0.0.1:5678

# Production webhook paths for the two workflows (must be ACTIVE/PUBLISHED in n8n).
N8N_GENERATE_PLAN_PATH=/webhook/mr01-generate-plan
N8N_REVISE_PLAN_PATH=/webhook/mr02-revise-plan
MR03_WEBHOOK_URL=http://127.0.0.1:5678/webhook/mr03-query-planner
MR04_WEBHOOK_URL=http://127.0.0.1:5678/webhook/mr04-filter-ads-paced-v4
MR04_TEST_WEBHOOK_URL=http://127.0.0.1:5678/webhook-test/mr04-filter-ads-paced-v4
MR05_WEBHOOK_URL=http://127.0.0.1:5678/webhook/mr05-resolve-potential-v1
MR05_TEST_WEBHOOK_URL=http://127.0.0.1:5678/webhook-test/mr05-resolve-potential-v1

# APIFY provider (active research pipeline).
APIFY_API_TOKEN=
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_ACTOR_ID=curious_coder/facebook-ads-library-scraper
APIFY_POLL_INTERVAL_MS=4000
APIFY_RUN_TIMEOUT_MS=1200000
APIFY_LIMIT_PER_SOURCE=200
APIFY_MAX_RECORDS_PER_QUERY=200
APIFY_SCRAPE_AD_DETAILS=false
APIFY_MAX_TOTAL_CHARGE_USD=5

# Meta Ads Library URL builder settings (still used to construct search URLs for Apify input).
META_AD_LIBRARY_COUNTRY=PL

# Deprecated (not used in active research path):
# META_AD_LIBRARY_ACCESS_TOKEN=

# No authentication between the app and n8n yet — both are loopback-only processes
# on the same developer machine, and designing app<->n8n auth before it's exposed to
# anything else would be premature. This is explicit FUTURE WORK before a VPS move —
# see docs/architecture/04-future-vps-switch.md and docs/architecture/09-security.md.

# How long the app waits for an n8n webhook response before giving up (milliseconds).
N8N_REQUEST_TIMEOUT_MS=60000
RELEVANCE_REQUEST_TIMEOUT_MS=300000
RELEVANCE_BATCH_SIZE=20
RELEVANCE_MAX_BATCH_SIZE=200
RELEVANCE_REQUESTS_PER_MINUTE=14

# When true, the app's n8n client returns a canned, schema-valid DiscoveryPlanV1
# instead of calling n8n at all — useful for frontend/dev work without n8n running.
LLM_MOCK_MODE=false
